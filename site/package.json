{
  "name": "wordcell-site",
  "version": "0.22.2",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:theme": "bun scripts/check-paper-theme.mjs",
    "sync:readme": "bun scripts/sync-readme.ts",
    "sync:docs": "bun scripts/sync-docs.ts",
    "sync:reader": "bun scripts/sync-reader.ts",
    "build:theme": "bun scripts/build-theme-bootstrap.ts",
    "dev": "bun run sync:readme && bun run sync:docs && bun run sync:reader && bun run build:theme && next dev --webpack",
    "prebuild": "bun run sync:readme && bun run sync:docs && bun run sync:reader && bun run build:theme",
    "build": "next build --webpack",
    "postbuild": "bun test ./tests/runtime.test.ts",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test": "bun test ./tests/source.test.ts ./tests/home.test.tsx ./scripts/readme-html.test.ts ./tests/ui-styles.test.tsx ./tests/hosted.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run check:theme && bun run sync:readme && bun run sync:docs && bun run sync:reader && bun run build:theme && bun run test && bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.15.0",
    "@hraness/site-footer": "github:hraness/site-footer#v0.15.0",
    "@hraness/ui": "github:hraness/ui#v0.5.16",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.6.0",
    "@hraness/wordcell": "https://github.com/hraness/wordcell/releases/download/v0.22.1/hraness-wordcell-0.22.1.tgz",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/bun": "1.3.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.2.1",
    "typescript": "6.0.3",
    "postcss": "8.5.28"
  },
  "type": "module"
}
